# --- Verplicht ---------------------------------------------------------------

# Postgres-verbinding. Lokaal bijvoorbeeld:
#   postgresql://postgres@127.0.0.1:5432/giftapp?schema=public
# Op Vercel: de connection string van Neon / Vercel Postgres / Supabase.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/giftapp?schema=public"

# Sleutel waarmee inlog-cookies worden ondertekend. Genereer een eigen waarde met:
#   openssl rand -base64 32
AUTH_SECRET="verander-mij-in-productie"

# --- Optioneel ---------------------------------------------------------------

# Een directe verbinding naar dezelfde database, dus zonder connectiepooler.
# Alleen nodig als je DATABASE_URL wél door een pooler loopt (zoals bij Neon of
# Supabase): databasemigraties werken daar niet betrouwbaar doorheen. De app
# zelf blijft gewoon DATABASE_URL gebruiken.
#
# Zet dit alleen zelf als je hoster geen kant-en-klare variabele levert. De
# Neon-koppeling op Vercel zet DATABASE_URL_UNPOOLED, en die wordt automatisch
# herkend — dan hoef je hier niets te doen.
# DIRECT_URL=""

# Zet op "off" als de app géén gratis leesdiensten (r.jina.ai, allorigins.win,
# codetabs.com, microlink.io, het Internet Archive) mag gebruiken voor pagina's
# die hij zelf niet binnenkomt. Zonder die diensten lukt het uitlezen van
# bol.com en Amazon niet, en valt de app terug op wat er in de link zelf staat.
# Er gaan alleen openbare productlinks naartoe.
# SCRAPER_READERS="off"

# Zet dit als je productafbeeldingen als eigen kopie wil bewaren (aanbevolen in
# productie). Zonder deze variabele worden afbeeldingen naar public/uploads
# geschreven — prima lokaal en bij zelf hosten, maar op Vercel is dat
# bestandssysteem alleen-lezen. De app valt dan terug op de originele URL van de
# webshop, dus je ziet nog steeds een foto; hij kan alleen breken als de winkel
# die URL later wijzigt.
# BLOB_READ_WRITE_TOKEN=""
