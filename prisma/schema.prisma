// Wenslijst — datamodel
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Occasion {
  BIRTHDAY
  CHRISTMAS
  SINTERKLAAS
  WEDDING
  BABY
  HOUSEWARMING
  GRADUATION
  OTHER
}

enum Visibility {
  PRIVATE // alleen de eigenaar
  FRIENDS // alleen mensen die je als vriend hebt
  LINK // iedereen met de deel-link
  PUBLIC // ook zichtbaar op het profiel van de eigenaar
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  handle       String   @unique
  locale       String   @default("nl")
  /// Wordt getoond op je profielpagina, dus zichtbaar voor iedereen.
  avatarUrl    String?
  bio          String?
  /// Onraadbare code achter je uitnodigingslink; pas aangemaakt bij gebruik.
  inviteCode   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lists            List[]
  listMemberships  ListMember[]
  listInvites      ListInvite[]
  friendsAsA       Friendship[]    @relation("FriendA")
  friendsAsB       Friendship[]    @relation("FriendB")
  requestsSent     FriendRequest[] @relation("RequestFrom")
  requestsReceived FriendRequest[] @relation("RequestTo")
}

/**
 * Een vriendschap staat één keer in de tabel, niet twee keer. Om te voorkomen
 * dat hetzelfde stel er twee keer in komt, ligt de volgorde vast: aId is altijd
 * de kleinste van de twee id's.
 */
model Friendship {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  createdAt DateTime @default(now())

  a User @relation("FriendA", fields: [aId], references: [id], onDelete: Cascade)
  b User @relation("FriendB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
  @@index([bId])
}

/**
 * Iemand die met de eigenaar aan dezelfde lijst werkt. De eigenaar zelf staat
 * hier niet in: die is List.userId. Samen mogen het er hoogstens tien zijn.
 */
model ListMember {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  createdAt DateTime @default(now())

  /// Een gedeelde lijst staat op ieders profiel. Wie hem daar liever niet
  /// heeft, zet dit aan: dan verdwijnt hij van dit ene profiel, en blijft hij
  /// bij de anderen gewoon staan.
  hiddenOnProfile Boolean @default(false)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

/// Een uitnodiging om mee te doen aan een lijst.
model ListInvite {
  id        String   @id @default(cuid())
  listId    String
  toId      String
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  to   User @relation(fields: [toId], references: [id], onDelete: Cascade)

  @@unique([listId, toId])
  @@index([toId])
}

/// Een verstuurde uitnodiging. Bij accepteren wordt het een Friendship.
model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from User @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

model List {
  id            String     @id @default(cuid())
  userId        String
  title         String
  description   String?
  occasion      Occasion   @default(OTHER)
  eventDate     DateTime?
  coverColor    String     @default("terracotta")
  coverImageUrl String?
  visibility    Visibility @default(LINK)
  shareCode     String     @unique
  /// Onraadbare code achter de link om samen aan deze lijst te werken.
  collabCode    String?    @unique
  position      Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts   Gift[]
  members ListMember[]
  invites ListInvite[]

  @@index([userId])
}

model Gift {
  id          String   @id @default(cuid())
  listId      String
  title       String
  description String?
  note        String? // maat, kleur, variant
  priceCents  Int?
  currency    String   @default("EUR")
  url         String?
  merchant    String?
  imageUrl    String?
  priority    Int      @default(3) // 1 t/m 5 sterren; 5 = het liefst
  quantity    Int      @default(1)
  position    Int      @default(0)
  /// Hetzelfde cadeau kan in meerdere lijsten staan; elke lijst krijgt een
  /// eigen rij, en die rijen delen deze code. Zo weet de app in welke lijsten
  /// een cadeau staat, ook al is het per lijst apart te bewerken.
  groupId     String   @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  list   List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  claims Claim[]

  @@index([listId])
  @@index([groupId])
}

/// Een reservering door een bezoeker. Wordt NOOIT aan de eigenaar van de lijst
/// getoond; zie lib/gifts.ts (getListForOwner vs. getListForVisitor).
model Claim {
  id           String   @id @default(cuid())
  giftId       String
  claimerName  String
  claimerToken String // anoniem token uit de cookie van de bezoeker
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@index([giftId])
  @@index([claimerToken])
}
