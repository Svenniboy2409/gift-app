// Wenslijst — datamodel
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Occasion {
  BIRTHDAY
  CHRISTMAS
  SINTERKLAAS
  WEDDING
  BABY
  HOUSEWARMING
  GRADUATION
  OTHER
}

enum Visibility {
  PRIVATE // alleen de eigenaar
  LINK // iedereen met de deel-link
  PUBLIC // ook zichtbaar op het profiel van de eigenaar
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  handle       String   @unique
  locale       String   @default("nl")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lists List[]
}

model List {
  id            String     @id @default(cuid())
  userId        String
  title         String
  description   String?
  occasion      Occasion   @default(OTHER)
  eventDate     DateTime?
  coverColor    String     @default("terracotta")
  coverImageUrl String?
  visibility    Visibility @default(LINK)
  shareCode     String     @unique
  position      Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts Gift[]

  @@index([userId])
}

model Gift {
  id          String   @id @default(cuid())
  listId      String
  title       String
  description String?
  note        String? // maat, kleur, variant
  priceCents  Int?
  currency    String   @default("EUR")
  url         String?
  merchant    String?
  imageUrl    String?
  priority    Int      @default(2) // 1 = leuk, 2 = graag, 3 = heel graag
  quantity    Int      @default(1)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  list   List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  claims Claim[]

  @@index([listId])
}

/// Een reservering door een bezoeker. Wordt NOOIT aan de eigenaar van de lijst
/// getoond; zie lib/gifts.ts (getListForOwner vs. getListForVisitor).
model Claim {
  id           String   @id @default(cuid())
  giftId       String
  claimerName  String
  claimerToken String // anoniem token uit de cookie van de bezoeker
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@index([giftId])
  @@index([claimerToken])
}
